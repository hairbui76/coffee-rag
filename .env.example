# ── Debug mode ────────────────────────────────────────────
DEBUG=false

# ── LLM Provider ──────────────────────────────────────────
# "openai"  → dùng OpenAI API (cần OPENAI_API_KEY)
# "ollama"  → dùng Ollama local (mặc định localhost:11434)
# "anthropic" → dùng Anthropic API (cần ANTHROPIC_API_KEY)
LLM_PROVIDER=anthropic

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Embedding model (sentence-transformers) ──────────────
# Đổi model rồi chạy lại: python -m src.preprocessing.build_embeddings --force
# BGE-M3: 1024-dim, multilingual, dense+sparse retrieval
EMBEDDING_MODEL=BAAI/bge-m3

# ── Retrieval settings ────────────────────────────────────
TOP_K_BEANS=5
TOP_K_NEWS=5

# ── Ragas evaluation ──────────────────────────────────────
# Judge: RAGAS_JUDGE_PROVIDER=anthropic|openai (mặc định: anthropic nếu chỉ có ANTHROPIC_API_KEY)
RAGAS_JUDGE_PROVIDER=anthropic
RAGAS_EVALUATOR_MODEL=claude-haiku-5-5
# Embedding cho answer relevancy + soft recall: bge-m3 chạy local, không cần key
RAGAS_AR_EMBEDDING_MODEL=BAAI/bge-m3
# Chỉ dùng khi muốn embedding OpenAI (cần OPENAI_API_KEY)
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_DO_NOT_TRACK=true

# ── Ollama (nếu LLM_PROVIDER=ollama) ─────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:e4b
OLLAMA_API_KEY=
